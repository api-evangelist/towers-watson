          "http": {
            "method": "PUT",
            "url": "https://api.wtwco.com/hrportal/v1/content/:contentId",
            "params": [
              {
                "name": "contentId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing content item."
        }
      ]
